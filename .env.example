# Copy this file to `.env` and fill in your real values.

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Google AI Studio (https://aistudio.google.com)
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Qdrant. If unset, uses in-process :memory: (lost on restart).
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Optional: tweak defaults
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIMS=768
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LOG_LEVEL=INFO
# LOG_JSON=true

# ─── LLM provider ────────────────────────────────────────────                                                                                                
# Which LLM backend to use: "deepseek" (default) or "gemma".
# - "deepseek" → uses the OpenAI SDK pointed at DeepSeek (needs DEEPSEEK_API_KEY)                                                                              
# - "gemma"    → uses the google-genai SDK with a Gemma model                                                                                                  
#                (reuses GOOGLE_API_KEY, no DEEPSEEK_API_KEY needed)
LLM_PROVIDER=deepseek                                                                                                                                          
                                                                                                                                                                
# ─── DeepSeek (used when LLM_PROVIDER=deepseek) ───────────────
DEEPSEEK_API_KEY=                                                                                                                                              
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SEC=60

# ─── Gemma (used when LLM_PROVIDER=gemma) ────────────────────                                                                                                
# Common values: gemma-3-27b-it, gemma-3-12b-it, gemma-3-4b-it, gemma-3-1b-it
GEMMA_MODEL=gemma-3-27b-it                                                                                                                                     
                
For your case (no DeepSeek key), set in your actual .env:                                                                                                      

LLM_PROVIDER=gemma                                                                                                                                             
GEMMA_MODEL=gemma-3-27b-it
GOOGLE_API_KEY=<your existing key>
# DEEPSEEK_API_KEY can be left empty/removed
